{% comment %}
  Promo Banner Section
  - Shows a promotional message with a product image, a dismiss control and a CTA.
{% endcomment %}

{% style %}
  .promo-banner {
    padding: 2rem 0;
    background-color: {{ section.settings.background_color }};
  }

  .promo-banner__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 120rem;
    margin: 0 auto;
  }

  .promo-banner__image {
    width: 12rem;
    height: 12rem;
    object-fit: cover;
  }

  .promo-banner__close {
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }

  .promo-banner__cta {
    display: inline-block;
    padding: 1.2rem 2.4rem;
    background: #1a1a1a;
    color: #fff;
    outline: none;
  }

  .promo-banner h2 {
    font-size: 3.2rem;
    line-height: 1.2;
    margin: 0 0 0.8rem;
  }
{% endstyle %}

<section class="promo-banner">
  <div class="promo-banner__inner page-width">
    <img
      class="promo-banner__image"
      src="{{ section.settings.image | image_url: width: 240 }}"
      width="240"
      height="240"
      loading="lazy"
    >

    <div class="promo-banner__text">
      <{{ section.settings.heading_tag }} class="h2">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>

      <p class="promo-banner__price">Only $49 — Free shipping on US orders over $75</p>

      {% render 'promo-countdown', ends_at: section.settings.ends_at %}

      <div class="promo-banner__cta" onclick="window.location.href='{{ section.settings.cta_url }}'">
        {{ section.settings.cta_label }}
      </div>
    </div>

    <button class="promo-banner__close" onclick="this.closest('.promo-banner').remove()">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1 1 L15 15 M15 1 L1 15" stroke="currentColor" stroke-width="2" />
      </svg>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "class": "promo-banner-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Limited time offer" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop now" },
    { "type": "text", "id": "ends_at", "label": "Offer ends at" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f6f2eb" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}
