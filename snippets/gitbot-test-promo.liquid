{% comment %}
  GitBot test snippet — not rendered anywhere. Opened to verify the
  "GitBot ADA" merge block on Main. Do not merge; close when done.
{% endcomment %}

<div class="gitbot-test-promo">
  <img src="{{ 'promo-banner.jpg' | asset_url }}" width="600" height="200">

  <div class="gitbot-test-promo__cta" onclick="window.location.href='/collections/all'">
    Shop now
  </div>

  <input type="email" placeholder="Email address" class="gitbot-test-promo__email">

  <a href="/pages/size-guide">click here</a>

  <p style="color: #bbbbbb; background: #ffffff; font-size: 10px;">
    Free shipping on orders over $75
  </p>

  <div class="gitbot-test-promo__close" onclick="this.parentElement.remove()">
    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2"/></svg>
  </div>
</div>
