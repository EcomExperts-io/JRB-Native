{% comment %}
  GitBot test snippet — not rendered anywhere. Opened to verify the
  "GitBot ADA" merge block on Main passes clean changes. Do not merge;
  close when done.
{% endcomment %}

<section class="gitbot-test-promo" aria-labelledby="gitbot-test-promo-heading">
  <h2 id="gitbot-test-promo-heading" class="gitbot-test-promo__heading">Free shipping on orders over $75</h2>

  <img
    src="{{ 'promo-banner.jpg' | asset_url }}"
    alt="Taos Footwear promotional banner"
    width="600"
    height="200"
    loading="lazy"
  >

  <a href="/collections/all" class="button gitbot-test-promo__cta">Shop all styles</a>

  <form action="/contact#newsletter" method="post" class="gitbot-test-promo__form">
    <label for="gitbot-test-promo-email">Email address</label>
    <input type="email" id="gitbot-test-promo-email" name="contact[email]" autocomplete="email" required>
    <button type="submit" class="button">Subscribe</button>
  </form>

  <a href="/pages/size-guide">View the size guide</a>

  <button type="button" class="gitbot-test-promo__close" aria-label="Close promotion">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2"/></svg>
  </button>
</section>
